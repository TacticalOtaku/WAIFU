{{#if hasReport}}
  <div class="waifu-analytics-strip">
    <section class="waifu-card">
      <h3>
        <span>{{localize "WAIFU.Charts.StorageState"}}</span>
        <span class="waifu-mono">{{stats.storageStats.formattedTrackedSize}}</span>
      </h3>
      {{{charts.storageDonutHtml}}}
      {{{charts.storageStateBarHtml}}}
    </section>

    <section class="waifu-card">
      <h3>
        <span>{{localize "WAIFU.Charts.StorageNamespaces"}}</span>
        <span class="waifu-mono">{{stats.storageStats.reclaimablePercent}}% {{localize "WAIFU.Sidebar.Reclaimable"}}</span>
      </h3>
      {{{charts.topNamespacesSvg}}}
    </section>
  </div>
{{/if}}

<div class="waifu-toolbar">
  <div class="waifu-search">
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    <label class="waifu-sr-only" for="waifu-storage-search">{{localize "WAIFU.Storage.SearchPlaceholder"}}</label>
    <input
      id="waifu-storage-search"
      type="search"
      value="{{filters.storageQuery}}"
      placeholder="{{localize 'WAIFU.Storage.SearchPlaceholder'}}"
      data-filter-input="storage"
    >
  </div>

  <div class="waifu-filters" role="group" aria-label="{{localize 'WAIFU.Tabs.Storage'}}">
    {{#each storageFilterChips}}
      <button
        type="button"
        class="waifu-chip"
        data-action="setStorageFilter"
        data-filter="{{this.id}}"
        aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"
      >{{this.label}}</button>
    {{/each}}
  </div>

  <div class="waifu-toolbar-tools">
    <button type="button" class="waifu-btn is-sm" data-action="backupStorage" {{#unless hasReport}}disabled{{/unless}}>
      <i class="fa-solid fa-download" aria-hidden="true"></i>
      {{localize "WAIFU.Storage.BtnBackup"}}
    </button>
  </div>
</div>

<div class="waifu-section-head">
  <h2>{{localize "WAIFU.Storage.SettingsHeading"}}</h2>
  <button
    type="button"
    class="waifu-btn is-sm is-danger"
    data-action="deleteAllOrphanSettings"
    {{#unless settings.orphanedCount}}disabled{{/unless}}
    {{#if busy}}disabled{{/if}}
  >{{localize "WAIFU.Storage.BtnDeleteAllOrphanSettings"}} ({{settings.orphanedCount}})</button>
</div>

{{#if settingRows.length}}
  <div tabindex="0" role="region" aria-labelledby="waifu-settings-caption" class="waifu-table-wrap">
    <table class="waifu-table" data-waifu-table="settings">
      <caption id="waifu-settings-caption">{{localize "WAIFU.Storage.SettingsHeading"}}</caption>
      <thead>
        <tr>
          <th scope="col" data-type="string">
            <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColNamespace"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
          </th>
          <th scope="col" data-type="string">
            <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColKeyOrDoc"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
          </th>
          <th scope="col" data-type="string">
            <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColStatus"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
          </th>
          <th scope="col" data-type="number">
            <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColSize"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
          </th>
          <th scope="col">{{localize "WAIFU.Storage.ColActions"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each settingRows}}
          <tr data-waifu-row="setting" data-search="{{this.searchText}}" data-category="{{this.status}}">
            <th scope="row"><span class="waifu-mono">{{this.namespace}}</span></th>
            <td><span class="waifu-mono waifu-ellipsis">{{this.settingKey}}</span></td>
            <td><span class="waifu-badge is-{{this.severity}}">{{this.statusLabel}}</span></td>
            <td data-value="{{this.bytes}}"><strong>{{this.formattedSize}}</strong></td>
            <td>
              <div class="waifu-row-actions">
                <button type="button" class="waifu-btn is-sm" data-action="inspectSetting" data-setting-key="{{this.key}}">
                  {{localize "WAIFU.Storage.BtnInspect"}}
                </button>
                <button
                  type="button"
                  class="waifu-btn is-sm is-danger"
                  data-action="deleteSingleSetting"
                  data-setting-key="{{this.key}}"
                  {{#if @root.busy}}disabled{{/if}}
                >{{localize "WAIFU.Storage.BtnDelete"}}</button>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <p class="waifu-empty">{{localize "WAIFU.Storage.EmptySettings"}}</p>
{{/if}}

<div class="waifu-section-head">
  <h2>{{localize "WAIFU.Storage.FlagsHeading"}}</h2>
  <button
    type="button"
    class="waifu-btn is-sm is-danger"
    data-action="deleteAllOrphanFlags"
    {{#unless flags.orphanedEntriesCount}}disabled{{/unless}}
    {{#if busy}}disabled{{/if}}
  >{{localize "WAIFU.Storage.BtnDeleteAllOrphanFlags"}} ({{flags.orphanedEntriesCount}})</button>
</div>

{{#if flagGroupRows.length}}
  <div tabindex="0" role="region" aria-labelledby="waifu-flags-caption" class="waifu-table-wrap">
    <table class="waifu-table" data-waifu-table="flags">
      <caption id="waifu-flags-caption">{{localize "WAIFU.Storage.FlagsHeading"}}</caption>
      <thead>
        <tr>
          <th scope="col" data-type="string">
            <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColNamespace"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
          </th>
          <th scope="col">{{localize "WAIFU.Storage.ColKeyOrDoc"}}</th>
          <th scope="col" data-type="number">
            <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColCount"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
          </th>
          <th scope="col" data-type="string">
            <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColStatus"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
          </th>
          <th scope="col" data-type="number">
            <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColSize"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
          </th>
          <th scope="col">{{localize "WAIFU.Storage.ColActions"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each flagGroupRows}}
          <tr data-waifu-row="flag-group" data-search="{{this.searchText}}" data-category="{{this.status}}">
            <th scope="row"><span class="waifu-mono">{{this.namespace}}</span></th>
            <td><span class="waifu-mono waifu-ellipsis">{{this.docTypesLabel}}</span></td>
            <td data-value="{{this.docCount}}">{{this.docCount}}</td>
            <td><span class="waifu-badge is-{{this.severity}}">{{this.statusLabel}}</span></td>
            <td data-value="{{this.bytes}}"><strong>{{this.formattedSize}}</strong></td>
            <td>
              <div class="waifu-row-actions">
                <button type="button" class="waifu-btn is-sm" data-action="inspectFlagGroup" data-group-id="{{this.id}}">
                  {{localize "WAIFU.Storage.BtnInspect"}}
                </button>
                <button
                  type="button"
                  class="waifu-btn is-sm is-danger"
                  data-action="deleteFlagGroup"
                  data-group-id="{{this.id}}"
                  {{#if @root.busy}}disabled{{/if}}
                >{{localize "WAIFU.Storage.BtnDelete"}}</button>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <p class="waifu-empty">{{localize "WAIFU.Storage.EmptyFlags"}}</p>
{{/if}}

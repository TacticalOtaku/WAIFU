{{#if hasReport}}
  <div class="waifu-analytics-strip">
    <section class="waifu-card">
      <div class="waifu-card-head">
        <h3>{{localize "WAIFU.Charts.StorageState"}}</h3>
        <span class="waifu-mini-metric is-warning">{{stats.storageStats.formattedTrackedSize}} • {{stats.storageStats.reclaimablePercent}}%</span>
      </div>
      {{{charts.storageDonutHtml}}}
      {{{charts.storageStateBarHtml}}}
    </section>

    <section class="waifu-card">
      <div class="waifu-card-head">
        <h3>{{localize "WAIFU.Charts.StorageNamespaces"}}</h3>
        <span class="waifu-mono">{{stats.storageStats.formattedReclaimableTotal}} {{localize "WAIFU.Sidebar.Reclaimable"}}</span>
      </div>
      {{{charts.topNamespacesSvg}}}
    </section>
  </div>
{{/if}}

<div class="waifu-toolbar">
  <div class="waifu-search">
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    <label class="waifu-sr-only" for="waifu-storage-search">{{localize "WAIFU.Storage.SearchPlaceholder"}}</label>
    <input
      id="waifu-storage-search"
      type="search"
      value="{{filters.storageQuery}}"
      placeholder="{{localize 'WAIFU.Storage.SearchPlaceholder'}}"
      data-filter-input="storage"
    >
  </div>

  <div class="waifu-filters" role="group" aria-label="{{localize 'WAIFU.Tabs.Storage'}}">
    {{#each storageFilterChips}}
      <button
        type="button"
        class="waifu-chip"
        data-action="setStorageFilter"
        data-filter="{{this.id}}"
        aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"
      >{{this.label}}</button>
    {{/each}}
  </div>

  <div class="waifu-toolbar-tools">
    <button type="button" class="waifu-btn is-sm" data-action="backupStorage" {{#unless hasReport}}disabled{{/unless}}>
      <i class="fa-solid fa-download" aria-hidden="true"></i>
      {{localize "WAIFU.Storage.BtnBackup"}}
    </button>
    <button type="button" class="waifu-btn is-sm" data-action="restoreBackup" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
      {{localize "WAIFU.Masthead.Restore"}}
    </button>
  </div>
</div>

<section class="waifu-card">
  <div class="waifu-card-head">
    <h3>{{localize "WAIFU.Storage.SettingsHeading"}}</h3>
    <button
      type="button"
      class="waifu-btn is-sm is-danger"
      data-action="deleteAllOrphanSettings"
      {{#unless settings.orphanedCount}}disabled{{/unless}}
      {{#if busy}}disabled{{/if}}
    >{{localize "WAIFU.Storage.BtnDeleteAllOrphanSettings"}} ({{settings.orphanedCount}})</button>
  </div>

  {{#if settingRows.length}}
    <div class="waifu-selection-bar" data-selection-bar="settings" hidden>
      <span class="waifu-badge is-accent" data-selection-count="settings">{{localize "WAIFU.Selection.Count" count=0}}</span>
      <div class="waifu-row-actions">
        <button
          type="button"
          class="waifu-btn is-sm is-danger"
          data-action="deleteSelectedSettings"
          data-sel-btn="delete"
          {{#if busy}}disabled{{/if}}
        >
          <i class="fa-solid fa-trash" aria-hidden="true"></i>
          <span data-sel-label>{{localize "WAIFU.Selection.DeleteSelected"}}</span>
        </button>
        <button
          type="button"
          class="waifu-btn is-sm"
          data-action="ignoreSelectedItems"
          data-select-kind="settings"
          data-sel-btn="ignore"
          {{#if busy}}disabled{{/if}}
        >
          <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
          <span data-sel-label>{{localize "WAIFU.Selection.IgnoreSelected"}}</span>
        </button>
        <button
          type="button"
          class="waifu-btn is-sm"
          data-action="clearSelection"
          data-select-kind="settings"
        >{{localize "WAIFU.Selection.Clear"}}</button>
      </div>
    </div>

    <div tabindex="0" role="region" aria-labelledby="waifu-settings-caption" class="waifu-table-wrap">
      <table class="waifu-table has-check-col" data-waifu-table="settings">
        <caption id="waifu-settings-caption">{{localize "WAIFU.Storage.SettingsHeading"}}</caption>
        <thead>
          <tr>
            <th scope="col" class="waifu-col-check">
              <input type="checkbox" class="waifu-check" data-select-all="settings" aria-label="{{localize 'WAIFU.Selection.SelectAll'}}">
            </th>
            <th scope="col" data-type="string">
              <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColNamespace"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
            </th>
            <th scope="col" data-type="string">
              <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColKeyOrDoc"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
            </th>
            <th scope="col" data-type="string">
              <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColStatus"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
            </th>
            <th scope="col" data-type="number">
              <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColSize"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
            </th>
            <th scope="col">{{localize "WAIFU.Storage.ColActions"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each settingRows}}
            <tr data-waifu-row="setting" data-select-id="{{this.key}}" data-search="{{this.searchText}}" data-category="{{this.filterTags}}">
              <td class="waifu-col-check">
                <input type="checkbox" class="waifu-check" data-select-row="settings" data-select-id="{{this.key}}" {{#if this.selected}}checked{{/if}} aria-label="{{this.key}}">
              </td>
              <th scope="row"><span class="waifu-mono">{{this.namespace}}</span></th>
              <td><span class="waifu-mono waifu-ellipsis" title="{{this.settingKey}}">{{this.settingKey}}</span></td>
              <td><span class="waifu-badge is-{{this.severity}}">{{this.statusLabel}}</span></td>
              <td data-value="{{this.bytes}}"><strong>{{this.formattedSize}}</strong></td>
              <td>
                <div class="waifu-row-actions">
                  <button type="button" class="waifu-btn is-sm" data-action="inspectSetting" data-setting-key="{{this.key}}">
                    {{localize "WAIFU.Storage.BtnInspect"}}
                  </button>
                  <button
                    type="button"
                    class="waifu-btn is-sm"
                    data-action="toggleIgnoreItem"
                    data-ignore-category="settings"
                    data-ignore-id="{{this.key}}"
                    title="{{#if this.isIgnored}}{{localize 'WAIFU.Ignore.Unignore'}}{{else}}{{localize 'WAIFU.Ignore.Ignore'}}{{/if}}"
                  ><i class="fa-solid {{#if this.isIgnored}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i></button>
                  <button
                    type="button"
                    class="waifu-btn is-sm is-danger"
                    data-action="deleteSingleSetting"
                    data-setting-key="{{this.key}}"
                    {{#if @root.busy}}disabled{{/if}}
                  >{{localize "WAIFU.Storage.BtnDelete"}}</button>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="waifu-empty">{{localize "WAIFU.Storage.EmptySettings"}}</p>
  {{/if}}
</section>

<section class="waifu-card">
  <div class="waifu-card-head">
    <h3>{{localize "WAIFU.Storage.FlagsHeading"}}</h3>
    <button
      type="button"
      class="waifu-btn is-sm is-danger"
      data-action="deleteAllOrphanFlags"
      {{#unless flags.orphanedEntriesCount}}disabled{{/unless}}
      {{#if busy}}disabled{{/if}}
    >{{localize "WAIFU.Storage.BtnDeleteAllOrphanFlags"}} ({{flags.orphanedEntriesCount}})</button>
  </div>

  {{#if flagGroupRows.length}}
    <div class="waifu-selection-bar" data-selection-bar="flags" hidden>
      <span class="waifu-badge is-accent" data-selection-count="flags">{{localize "WAIFU.Selection.Count" count=0}}</span>
      <div class="waifu-row-actions">
        <button
          type="button"
          class="waifu-btn is-sm is-danger"
          data-action="deleteSelectedFlagGroups"
          data-sel-btn="delete"
          {{#if busy}}disabled{{/if}}
        >
          <i class="fa-solid fa-trash" aria-hidden="true"></i>
          <span data-sel-label>{{localize "WAIFU.Selection.DeleteSelected"}}</span>
        </button>
        <button
          type="button"
          class="waifu-btn is-sm"
          data-action="ignoreSelectedItems"
          data-select-kind="flags"
          data-sel-btn="ignore"
          {{#if busy}}disabled{{/if}}
        >
          <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
          <span data-sel-label>{{localize "WAIFU.Selection.IgnoreSelected"}}</span>
        </button>
        <button
          type="button"
          class="waifu-btn is-sm"
          data-action="clearSelection"
          data-select-kind="flags"
        >{{localize "WAIFU.Selection.Clear"}}</button>
      </div>
    </div>

    <div tabindex="0" role="region" aria-labelledby="waifu-flags-caption" class="waifu-table-wrap">
      <table class="waifu-table has-check-col" data-waifu-table="flags">
        <caption id="waifu-flags-caption">{{localize "WAIFU.Storage.FlagsHeading"}}</caption>
        <thead>
          <tr>
            <th scope="col" class="waifu-col-check">
              <input type="checkbox" class="waifu-check" data-select-all="flags" aria-label="{{localize 'WAIFU.Selection.SelectAll'}}">
            </th>
            <th scope="col" data-type="string">
              <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColNamespace"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
            </th>
            <th scope="col">{{localize "WAIFU.Storage.ColKeyOrDoc"}}</th>
            <th scope="col" data-type="number">
              <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColCount"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
            </th>
            <th scope="col" data-type="string">
              <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColStatus"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
            </th>
            <th scope="col" data-type="number">
              <button type="button" data-action="sortTable">{{localize "WAIFU.Storage.ColSize"}} <i class="fa-solid fa-caret-up waifu-sort-icon" aria-hidden="true"></i></button>
            </th>
            <th scope="col">{{localize "WAIFU.Storage.ColActions"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each flagGroupRows}}
            <tr data-waifu-row="flag-group" data-select-id="{{this.id}}" data-search="{{this.searchText}}" data-category="{{this.filterTags}}">
              <td class="waifu-col-check">
                <input type="checkbox" class="waifu-check" data-select-row="flags" data-select-id="{{this.id}}" {{#if this.selected}}checked{{/if}} aria-label="{{this.namespace}}">
              </td>
              <th scope="row"><span class="waifu-mono">{{this.namespace}}</span></th>
              <td><span class="waifu-mono waifu-ellipsis">{{this.docTypesLabel}}</span></td>
              <td data-value="{{this.docCount}}">{{this.docCount}}</td>
              <td><span class="waifu-badge is-{{this.severity}}">{{this.statusLabel}}</span></td>
              <td data-value="{{this.bytes}}"><strong>{{this.formattedSize}}</strong></td>
              <td>
                <div class="waifu-row-actions">
                  <button type="button" class="waifu-btn is-sm is-accent-outline" data-action="inspectFlagGroup" data-group-id="{{this.id}}">
                    {{localize "WAIFU.Drawer.BtnInspector"}} ↗
                  </button>
                  <button
                    type="button"
                    class="waifu-btn is-sm"
                    data-action="toggleIgnoreItem"
                    data-ignore-category="flags"
                    data-ignore-id="{{this.namespace}}"
                    title="{{#if this.isIgnored}}{{localize 'WAIFU.Ignore.Unignore'}}{{else}}{{localize 'WAIFU.Ignore.Ignore'}}{{/if}}"
                  ><i class="fa-solid {{#if this.isIgnored}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i></button>
                  <button
                    type="button"
                    class="waifu-btn is-sm is-danger"
                    data-action="deleteFlagGroup"
                    data-group-id="{{this.id}}"
                    {{#if @root.busy}}disabled{{/if}}
                  >{{localize "WAIFU.Storage.BtnDelete"}}</button>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="waifu-empty">{{localize "WAIFU.Storage.EmptyFlags"}}</p>
  {{/if}}
</section>

{{#if hasReport}}
  <section class="waifu-card">
    <div class="waifu-card-head">
      <h3>{{localize "WAIFU.Extras.Title"}}</h3>
      <span class="waifu-mono">{{extras.chatMessagesCount}} / {{extras.combatsCount}}</span>
    </div>
    <div class="waifu-rec-list">
      <div class="waifu-rec-item">
        <div class="waifu-cell-stack">
          <strong>{{localize "WAIFU.Extras.ChatTitle"}} ({{extras.chatMessagesCount}})</strong>
          <span class="waifu-mono">{{extras.formattedChatBytes}} • {{localize "WAIFU.Extras.LimitLabel"}} {{extras.maxChatMessages}}</span>
        </div>
        <button type="button" class="waifu-btn is-sm" data-action="archiveChatMessages" {{#unless extras.chatMessagesCount}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
          <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
          {{localize "WAIFU.Extras.BtnPruneChat"}}
        </button>
      </div>
      <div class="waifu-rec-item">
        <div class="waifu-cell-stack">
          <strong>{{localize "WAIFU.Extras.StaleCombatsTitle"}} ({{extras.staleCombatsCount}} / {{extras.combatsCount}})</strong>
          <span class="waifu-mono">{{localize "WAIFU.Extras.StaleCombatsHint"}}</span>
        </div>
        <button type="button" class="waifu-btn is-sm is-danger" data-action="cleanStaleCombats" {{#unless extras.staleCombatsCount}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
          <i class="fa-solid fa-trash" aria-hidden="true"></i>
          {{localize "WAIFU.Extras.BtnCleanCombats"}}
        </button>
      </div>
    </div>
  </section>
{{/if}}

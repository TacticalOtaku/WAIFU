<div class="waifu-card">
  <div class="waifu-section-head">
    <div>
      <h3>{{localize "WAIFU.Report.Title"}}</h3>
      <p class="waifu-mono">{{localize "WAIFU.Report.Subtitle"}}</p>
    </div>

    <div class="waifu-row-actions">
      <button type="button" class="waifu-btn is-sm is-primary" data-action="exportHtml" {{#unless hasReport}}disabled{{/unless}}>
        <i class="fa-solid fa-file-waveform" aria-hidden="true"></i>
        {{localize "WAIFU.Report.BtnDownloadHtml"}}
      </button>
      <button type="button" class="waifu-btn is-sm" data-action="exportMarkdown" {{#unless hasReport}}disabled{{/unless}}>
        <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
        {{localize "WAIFU.Report.BtnDownloadMd"}}
      </button>
      <button type="button" class="waifu-btn is-sm" data-action="exportJson" {{#unless hasReport}}disabled{{/unless}}>
        <i class="fa-solid fa-file-code" aria-hidden="true"></i>
        {{localize "WAIFU.Report.BtnDownloadJson"}}
      </button>
      <button type="button" class="waifu-btn is-sm" data-action="copyMarkdown" {{#unless hasReport}}disabled{{/unless}}>
        <i class="fa-solid fa-copy" aria-hidden="true"></i>
        {{localize "WAIFU.Report.BtnCopyMd"}}
      </button>
      <button type="button" class="waifu-btn is-sm" data-action="saveJournalReport" {{#unless hasReport}}disabled{{/unless}}>
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
        {{localize "WAIFU.Report.BtnCreateJournal"}}
      </button>
    </div>
  </div>

  {{#if hasReport}}
    <div class="waifu-mode-switch" role="group" aria-label="{{localize 'WAIFU.Report.ViewModeLabel'}}">
      <button
        type="button"
        class="waifu-chip"
        data-action="setReportMode"
        data-mode="visual"
        aria-pressed="{{#if isReportVisual}}true{{else}}false{{/if}}"
      >
        <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
        {{localize "WAIFU.Report.ModeVisual"}}
      </button>
      <button
        type="button"
        class="waifu-chip"
        data-action="setReportMode"
        data-mode="markdown"
        aria-pressed="{{#if isReportMarkdown}}true{{else}}false{{/if}}"
      >
        <i class="fa-brands fa-markdown" aria-hidden="true"></i>
        {{localize "WAIFU.Report.ModeMarkdown"}}
      </button>
      <button
        type="button"
        class="waifu-chip"
        data-action="setReportMode"
        data-mode="journal"
        aria-pressed="{{#if isReportJournal}}true{{else}}false{{/if}}"
      >
        <i class="fa-solid fa-book" aria-hidden="true"></i>
        {{localize "WAIFU.Report.ModeJournal"}}
      </button>
    </div>
  {{/if}}
</div>

{{#if hasReport}}
  {{#if isReportVisual}}
    {{{visualReportHtml}}}
  {{else if isReportMarkdown}}
    <section class="waifu-card">
      <h3><span>{{localize "WAIFU.Report.PreviewHeading"}}</span></h3>
      <pre class="waifu-report-pre">{{markdownPreview}}</pre>
    </section>
  {{else}}
    <section class="waifu-card">
      <h3><span>{{localize "WAIFU.Report.JournalPreviewHeading"}}</span></h3>
      <div class="waifu-journal-preview">{{{journalPreviewHtml}}}</div>
    </section>
  {{/if}}
{{else}}
  <p class="waifu-empty">{{localize "WAIFU.Overview.RunFirst"}}</p>
{{/if}}

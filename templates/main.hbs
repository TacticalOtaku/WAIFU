<main class="waifu-main">
  <div class="waifu-sr-only" role="status" aria-live="polite" data-waifu-status>{{statusMessage}}</div>

  <div class="waifu-progress" data-waifu-progress {{#unless busy}}hidden{{/unless}}>
    <div class="waifu-progress-bar">
      <div class="waifu-progress-fill" data-waifu-progress-fill style="width:{{progressPercent}}%"></div>
    </div>
    <span class="waifu-mono waifu-ellipsis" data-waifu-progress-label>{{progressLabel}}</span>
    <button type="button" class="waifu-btn is-sm is-danger" data-action="cancelOperation">
      {{localize "Cancel"}}
    </button>
  </div>

  <div class="waifu-panels">
    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-overview"
      aria-labelledby="waifu-tab-overview"
      data-panel="overview"
      {{#unless isOverviewActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-overview.hbs"}}
      </div>
    </section>

    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-scenes"
      aria-labelledby="waifu-tab-scenes"
      data-panel="scenes"
      {{#unless isScenesActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-scenes.hbs"}}
      </div>
    </section>

    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-uuids"
      aria-labelledby="waifu-tab-uuids"
      data-panel="uuids"
      {{#unless isUuidsActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-uuids.hbs"}}
      </div>
    </section>

    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-storage"
      aria-labelledby="waifu-tab-storage"
      data-panel="storage"
      {{#unless isStorageActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-storage.hbs"}}
      </div>
    </section>

    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-report"
      aria-labelledby="waifu-tab-report"
      data-panel="report"
      {{#unless isReportActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-report.hbs"}}
      </div>
    </section>
  </div>
</main>

<main class="waifu-main">
  <header class="waifu-head">
    <div class="waifu-title-row">
      <button
        type="button"
        class="waifu-orb"
        data-action="runAudit"
        data-state="{{summary.healthState}}"
        style="--score: {{healthShare}}"
        aria-label="{{localize 'WAIFU.Header.Rescan'}}"
      >
        <span class="waifu-orb-glow" aria-hidden="true"></span>
        <span class="waifu-orb-pool" aria-hidden="true">
          <span class="waifu-orb-fill">
            <svg class="waifu-wave" viewBox="0 0 120 12" preserveAspectRatio="none">
              <path d="M0 6 Q 15 0 30 6 T 60 6 T 90 6 T 120 6 L 120 12 L 0 12 Z"></path>
            </svg>
            <svg class="waifu-wave is-back" viewBox="0 0 120 12" preserveAspectRatio="none">
              <path d="M0 6 Q 15 12 30 6 T 60 6 T 90 6 T 120 6 L 120 12 L 0 12 Z"></path>
            </svg>
          </span>
        </span>
        <span class="waifu-orb-n">{{summary.healthScore}}<small>%</small></span>
      </button>

      <div class="waifu-title-text">
        <h1 class="waifu-name">{{localize "WAIFU.ModuleTitle"}}</h1>
        <div class="waifu-links">
          <span>{{worldLine}}</span>
          <span class="waifu-dot" aria-hidden="true">•</span>
          <span>{{modulesLine}}</span>
          <span class="waifu-dot" aria-hidden="true">•</span>
          <span>{{scanLine}}</span>
        </div>
      </div>
    </div>

    <div class="waifu-tools">
      <button
        type="button"
        class="waifu-ibtn"
        data-action="runAudit"
        aria-label="{{localize 'WAIFU.Header.Rescan'}}"
        {{#if busy}}disabled{{/if}}
      >
        <i class="fa-solid fa-rotate {{#if busy}}fa-spin{{/if}}" aria-hidden="true"></i>
      </button>

      <div class="waifu-menu-wrap">
        <button
          type="button"
          class="waifu-ibtn"
          data-action="toggleAppearanceMenu"
          aria-expanded="{{#if appearanceOpen}}true{{else}}false{{/if}}"
          aria-haspopup="true"
          aria-label="{{localize 'WAIFU.Theme.Appearance'}}"
        >
          <i class="fa-solid fa-palette" aria-hidden="true"></i>
        </button>

        <div class="waifu-menu" {{#unless appearanceOpen}}hidden{{/unless}}>
          <span class="waifu-menu-label">{{localize "WAIFU.Settings.Theme.Name"}}</span>
          <div class="waifu-theme-row">
            <button
              type="button"
              class="waifu-btn is-sm {{#if isNightTheme}}is-primary{{/if}}"
              data-action="setTheme"
              data-theme-val="night"
            >{{localize "WAIFU.Theme.Night"}}</button>
            <button
              type="button"
              class="waifu-btn is-sm {{#if isParchmentTheme}}is-primary{{/if}}"
              data-action="setTheme"
              data-theme-val="parchment"
            >{{localize "WAIFU.Theme.Parchment"}}</button>
          </div>

          <span class="waifu-menu-label">{{localize "WAIFU.Settings.Accent.Name"}}</span>
          <div class="waifu-swatches">
            {{#each accents}}
              <button
                type="button"
                class="waifu-swatch"
                data-action="setAccent"
                data-accent-val="{{this.id}}"
                aria-label="{{this.label}}"
                aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"
              ></button>
            {{/each}}
          </div>
        </div>
      </div>

      <button
        type="button"
        class="waifu-ibtn"
        data-action="openModuleSettings"
        aria-label="{{localize 'WAIFU.Header.Thresholds'}}"
      >
        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
      </button>
    </div>

    <div class="waifu-kpis">
      <button type="button" class="waifu-kpi" data-action="selectTab" data-tab="scenes" data-tone="{{#if scenes.heavyScenesCount}}warning{{else}}heal{{/if}}">
        <span class="waifu-kpi-k">{{localize "WAIFU.Kpi.HeavyScenes"}}</span>
        <strong class="waifu-kpi-m">{{scenes.heavyScenesCount}}</strong>
        <span class="waifu-kpi-v">{{kpiSub.heavyScenes}}</span>
        <span class="waifu-kpi-s" aria-hidden="true">{{localize "WAIFU.Overview.OpenTab"}}</span>
      </button>

      <button type="button" class="waifu-kpi" data-action="selectTab" data-tab="scenes" data-tone="{{#if scenes.pngAssetsCount}}critical{{else if scenes.unoptimizedAssetsCount}}warning{{else}}heal{{/if}}">
        <span class="waifu-kpi-k">{{localize "WAIFU.Kpi.PngAssets"}}</span>
        <strong class="waifu-kpi-m">{{scenes.pngAssetsCount}}</strong>
        <span class="waifu-kpi-v">{{kpiSub.pngAssets}}</span>
        <span class="waifu-kpi-s" aria-hidden="true">{{localize "WAIFU.Overview.OpenTab"}}</span>
      </button>

      <button type="button" class="waifu-kpi" data-action="selectTab" data-tab="uuids" data-tone="{{#if uuids.brokenCount}}critical{{else}}heal{{/if}}">
        <span class="waifu-kpi-k">{{localize "WAIFU.Kpi.BrokenUuids"}}</span>
        <strong class="waifu-kpi-m">{{uuids.brokenCount}}</strong>
        <span class="waifu-kpi-v">{{kpiSub.brokenUuids}}</span>
        <span class="waifu-kpi-s" aria-hidden="true">{{localize "WAIFU.Overview.OpenTab"}}</span>
      </button>

      <button type="button" class="waifu-kpi" data-action="selectTab" data-tab="storage" data-tone="{{#if settings.bloatedCount}}warning{{else}}heal{{/if}}">
        <span class="waifu-kpi-k">{{localize "WAIFU.Kpi.BloatedSettings"}}</span>
        <strong class="waifu-kpi-m">{{settings.bloatedCount}}</strong>
        <span class="waifu-kpi-v">{{kpiSub.bloatedSettings}}</span>
        <span class="waifu-kpi-s" aria-hidden="true">{{localize "WAIFU.Overview.OpenTab"}}</span>
      </button>

      <button type="button" class="waifu-kpi" data-action="selectTab" data-tab="storage" data-tone="{{#if flags.orphanedNamespacesCount}}warning{{else}}heal{{/if}}">
        <span class="waifu-kpi-k">{{localize "WAIFU.Kpi.OrphanedFlags"}}</span>
        <strong class="waifu-kpi-m">{{flags.orphanedNamespacesCount}}</strong>
        <span class="waifu-kpi-v">{{kpiSub.orphanedFlags}}</span>
        <span class="waifu-kpi-s" aria-hidden="true">{{localize "WAIFU.Overview.OpenTab"}}</span>
      </button>

      <button type="button" class="waifu-kpi" data-action="selectTab" data-tab="overview" data-tone="{{#if summary.totalFixable}}accent{{else}}heal{{/if}}">
        <span class="waifu-kpi-k">{{localize "WAIFU.Kpi.Fixable"}}</span>
        <strong class="waifu-kpi-m">{{summary.totalFixable}}</strong>
        <span class="waifu-kpi-v">{{localize "WAIFU.Kpi.FixableSub"}}</span>
        <span class="waifu-kpi-s" aria-hidden="true">{{localize "WAIFU.Overview.OpenTab"}}</span>
      </button>
    </div>
  </header>

  <div class="waifu-tabs" role="tablist" aria-label="{{localize 'WAIFU.ModuleTitle'}}">
    {{#each navTabs}}
      <button
        type="button"
        role="tab"
        id="waifu-tab-{{this.id}}"
        class="waifu-tab"
        data-action="selectTab"
        data-tab="{{this.id}}"
        aria-selected="{{#if this.active}}true{{else}}false{{/if}}"
        tabindex="{{#if this.active}}0{{else}}-1{{/if}}"
      >
        <span>{{this.label}}</span>
        {{#if this.hasBadge}}
          <span class="waifu-tab-n">{{this.badge}}</span>
        {{/if}}
      </button>
    {{/each}}
  </div>

  <div class="waifu-sr-only" role="status" aria-live="polite" data-waifu-status>{{statusMessage}}</div>

  <div class="waifu-panels">
    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-overview"
      aria-labelledby="waifu-tab-overview"
      data-panel="overview"
      {{#unless isOverviewActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-overview.hbs"}}
      </div>
    </section>

    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-scenes"
      aria-labelledby="waifu-tab-scenes"
      data-panel="scenes"
      {{#unless isScenesActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-scenes.hbs"}}
      </div>
    </section>

    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-uuids"
      aria-labelledby="waifu-tab-uuids"
      data-panel="uuids"
      {{#unless isUuidsActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-uuids.hbs"}}
      </div>
    </section>

    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-storage"
      aria-labelledby="waifu-tab-storage"
      data-panel="storage"
      {{#unless isStorageActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-storage.hbs"}}
      </div>
    </section>

    <section
      class="waifu-panel"
      role="tabpanel"
      id="waifu-panel-report"
      aria-labelledby="waifu-tab-report"
      data-panel="report"
      {{#unless isReportActive}}hidden{{/unless}}
    >
      <div class="waifu-panel-inner">
        {{> "modules/waifu/templates/partials/tab-report.hbs"}}
      </div>
    </section>
  </div>
</main>

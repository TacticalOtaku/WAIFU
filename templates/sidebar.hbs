<aside class="waifu-sidebar" aria-label="{{localize 'WAIFU.Sidebar.SectionsTitle'}}">
  <section class="waifu-gauge-card" data-state="{{#if hasReport}}{{summary.healthState}}{{else}}idle{{/if}}">
    <div class="waifu-gauge-head">
      <span class="waifu-sidebar-label">{{localize "WAIFU.Sidebar.HealthTitle"}}</span>
      {{#if hasReport}}
        <span class="waifu-mono">-{{stats.scoreBreakdown.totalDeduction}} pts</span>
      {{/if}}
    </div>
    <div class="waifu-gauge-body">
      {{{charts.healthGaugeSvg}}}
    </div>
    {{#if hasReport}}
      <div class="waifu-gauge-pills">
        <span class="waifu-badge {{#if summary.criticalCount}}is-critical{{else}}is-ok{{/if}}">
          {{localize "WAIFU.Severity.critical"}}: {{summary.criticalCount}}
        </span>
        <span class="waifu-badge {{#if summary.warningCount}}is-warning{{else}}is-ok{{/if}}">
          {{localize "WAIFU.Severity.warning"}}: {{summary.warningCount}}
        </span>
        {{#if summary.infoCount}}
          <span class="waifu-badge is-info">
            {{localize "WAIFU.Severity.info"}}: {{summary.infoCount}}
          </span>
        {{/if}}
      </div>
    {{/if}}
  </section>

  <div class="waifu-toc-section">
    <h2 class="waifu-sidebar-title">{{localize "WAIFU.Sidebar.SectionsTitle"}}</h2>
    <nav class="waifu-toc" role="tablist" aria-orientation="vertical" aria-label="{{localize 'WAIFU.Sidebar.SectionsTitle'}}">
      {{#each navTabs}}
        <button
          type="button"
          role="tab"
          id="waifu-tab-{{this.id}}"
          class="waifu-toc-item"
          data-action="selectTab"
          data-tab="{{this.id}}"
          aria-selected="{{#if this.active}}true{{else}}false{{/if}}"
          tabindex="{{#if this.active}}0{{else}}-1{{/if}}"
        >
          <span class="waifu-toc-icon" aria-hidden="true">
            <i class="{{this.icon}}"></i>
          </span>
          <span class="waifu-toc-text">
            <strong>{{this.label}}</strong>
            {{#if this.subline}}
              <small>{{this.subline}}</small>
            {{/if}}
          </span>
          {{#if this.hasBadge}}
            <span class="waifu-toc-badge {{#if this.badgeTone}}is-{{this.badgeTone}}{{/if}}">{{this.badge}}</span>
          {{/if}}
        </button>
      {{/each}}
    </nav>
  </div>

  <section class="waifu-threshold-box">
    <h2 class="waifu-sidebar-title">
      <span>{{localize "WAIFU.Sidebar.ThresholdsTitle"}}</span>
      <button type="button" class="waifu-link-btn" data-action="openModuleSettings">
        {{localize "WAIFU.Header.Thresholds"}}
      </button>
    </h2>
    <div class="waifu-threshold-list">
      <div class="waifu-threshold-row">
        <span>{{localize "WAIFU.Sidebar.LimitTex"}}</span>
        <b>{{thresholds.maxTextureResolution}}px / {{thresholds.maxMegapixels}}MP</b>
      </div>
      <div class="waifu-threshold-row">
        <span>{{localize "WAIFU.Sidebar.LimitScene"}}</span>
        <b>{{thresholds.maxWalls}}w / {{thresholds.maxLights}}l / {{thresholds.maxAnimations}}a</b>
      </div>
      <div class="waifu-threshold-row">
        <span>{{localize "WAIFU.Sidebar.LimitDb"}}</span>
        <b>{{formattedThresholdBytes}} / {{formattedFlagThresholdBytes}}</b>
      </div>
      {{#if hasReport}}
        <div class="waifu-threshold-row is-highlight">
          <span>{{localize "WAIFU.Sidebar.Reclaimable"}}</span>
          <b>{{stats.storageStats.formattedReclaimableTotal}}</b>
        </div>
      {{/if}}
    </div>
  </section>
</aside>

<header class="waifu-masthead">
  <div class="waifu-masthead-brand">
    <div class="waifu-brand-emblem" aria-hidden="true">
      <i class="fa-solid fa-file-waveform"></i>
    </div>
    <div class="waifu-brand-text">
      <div class="waifu-brand-row">
        <h1 class="waifu-name">{{localize "WAIFU.ModuleTitle"}}</h1>
        <span class="waifu-badge is-{{summary.healthStateBadge}}">{{summary.healthScore}}%</span>
      </div>
      <div class="waifu-meta-line">
        <span>{{worldLine}}</span>
        <span class="waifu-dot" aria-hidden="true">•</span>
        <span>{{modulesLine}}</span>
        <span class="waifu-dot" aria-hidden="true">•</span>
        <span>{{scanLine}}</span>
      </div>
    </div>
  </div>

  <div class="waifu-masthead-actions">
    <button
      type="button"
      class="waifu-btn is-sm is-primary"
      data-action="runAudit"
      {{#if busy}}disabled{{/if}}
    >
      <i class="fa-solid fa-rotate {{#if busy}}fa-spin{{/if}}" aria-hidden="true"></i>
      <span>{{localize "WAIFU.Masthead.RunAudit"}}</span>
    </button>

    <button
      type="button"
      class="waifu-btn is-sm is-heal"
      data-action="fixAllRecommended"
      {{#unless hasAnyFixable}}disabled{{/unless}}
      {{#if busy}}disabled{{/if}}
    >
      <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
      <span>{{localize "WAIFU.Masthead.AutoFix"}}{{#if hasAnyFixable}} ({{summary.totalFixable}}){{/if}}</span>
    </button>

    <button
      type="button"
      class="waifu-btn is-sm"
      data-action="backupStorage"
      {{#unless hasReport}}disabled{{/unless}}
    >
      <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
      <span>{{localize "WAIFU.Masthead.Backup"}}</span>
    </button>

    <button
      type="button"
      class="waifu-btn is-sm"
      data-action="selectTab"
      data-tab="report"
      {{#unless hasReport}}disabled{{/unless}}
    >
      <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
      <span>{{localize "WAIFU.Masthead.ExportReport"}}</span>
    </button>

    <div class="waifu-menu-wrap">
      <button
        type="button"
        class="waifu-ibtn"
        data-action="toggleAppearanceMenu"
        aria-expanded="{{#if appearanceOpen}}true{{else}}false{{/if}}"
        aria-haspopup="true"
        aria-label="{{localize 'WAIFU.Theme.Appearance'}}"
        title="{{localize 'WAIFU.Theme.Appearance'}}"
      >
        <i class="fa-solid fa-palette" aria-hidden="true"></i>
      </button>

      <div class="waifu-menu" {{#unless appearanceOpen}}hidden{{/unless}}>
        <span class="waifu-menu-label">{{localize "WAIFU.Settings.Theme.Name"}}</span>
        <div class="waifu-theme-row">
          <button
            type="button"
            class="waifu-btn is-sm {{#if isNightTheme}}is-primary{{/if}}"
            data-action="setTheme"
            data-theme-val="night"
          >{{localize "WAIFU.Theme.Night"}}</button>
          <button
            type="button"
            class="waifu-btn is-sm {{#if isParchmentTheme}}is-primary{{/if}}"
            data-action="setTheme"
            data-theme-val="parchment"
          >{{localize "WAIFU.Theme.Parchment"}}</button>
        </div>

        <span class="waifu-menu-label">{{localize "WAIFU.Settings.Accent.Name"}}</span>
        <div class="waifu-swatches">
          {{#each accents}}
            <button
              type="button"
              class="waifu-swatch"
              data-action="setAccent"
              data-accent-val="{{this.id}}"
              aria-label="{{this.label}}"
              aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"
            ></button>
          {{/each}}
        </div>
      </div>
    </div>

    <button
      type="button"
      class="waifu-ibtn"
      data-action="openModuleSettings"
      aria-label="{{localize 'WAIFU.Header.Thresholds'}}"
      title="{{localize 'WAIFU.Header.Thresholds'}}"
    >
      <i class="fa-solid fa-sliders" aria-hidden="true"></i>
    </button>
  </div>
</header>
